{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hub",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8000}\""
      ],
      "port": 8000
    },
    {
      "name": "hub-8001",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8001}\""
      ],
      "port": 8001
    },
    {
      "name": "hub-8002",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"${PORT:-8002}\""
      ],
      "port": 8002
    },
    {
      "name": "hub-https",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 .claude/serve-https.py \"${PORT:-8443}\""
      ],
      "port": 8443,
      "url": "https://localhost:8443"
    },
    {
      "name": "song-server",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 tests/tools/song-server.py \"${PORT:-8003}\""
      ],
      "port": 8003
    }
  ]
}